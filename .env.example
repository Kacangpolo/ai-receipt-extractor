# Copy to .env and fill in. Never commit .env.

# Which LLM to use: gemini (free tier) or anthropic (paid)
LLM_PROVIDER=gemini

# Gemini - free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Stronger model, used only for receipts that fail the checks (empty = off)
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# Seconds between requests (free tier has a low requests-per-minute limit)
GEMINI_MIN_INTERVAL=6

# Anthropic (optional, paid) - https://platform.claude.com
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Local run (python on your laptop, Postgres in Docker):
DATABASE_URL=postgresql://receipts:receipts@localhost:5432/receipts

# Dashboard (online only). Leave empty on your laptop for full access.
# When set, visitors see a read-only demo; the password unlocks upload.
APP_PASSWORD=
MAX_UPLOAD=10
